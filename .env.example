# Required for application data, Prisma migrations, and Prisma Client generation.
# Use a pooled PostgreSQL connection URL for Vercel/serverless deployments.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/chronolux?sslmode=require"
# Optional direct/unpooled URL for `prisma migrate` when DATABASE_URL uses a pooler.
DIRECT_DATABASE_URL=""

# Required Auth.js signing secret. Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Payments. Real orders require Stripe secrets and a webhook secret.
# Use mock only with npm run dev. Mock payments are labeled TEST_PAID and take no money.
PAYMENT_MODE="mock"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Account recovery email. Required to deliver password-reset links.
RESEND_API_KEY=""
EMAIL_FROM="ChronoLux <accounts@example.com>"

# Product image uploads use Vercel Blob (configure this in Vercel Project Settings).
BLOB_READ_WRITE_TOKEN=""

# Optional public site origin for canonical metadata in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Store pricing defaults (public because estimates are shown in the browser).
# Review tax/shipping policy with your business before accepting live orders.
NEXT_PUBLIC_STORE_TAX_RATE="0.18"
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="10000"
NEXT_PUBLIC_STANDARD_SHIPPING_FEE="399"

# Optional social profiles shown on Contact and in the footer (use full https:// URLs).
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
